# ── dependencies ────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Next.js build output ────────────────────────────────────────────────
.next/
out/
next-env.d.ts

# ── tooling output ──────────────────────────────────────────────────────
*.tsbuildinfo
.eslintcache

# ── environment ─────────────────────────────────────────────────────────
# Never commit these. docs/deployment.md lists every variable the site
# reads, and .env.example is the committed template.
.env
.env.local
.env.*.local

# ── hosting ─────────────────────────────────────────────────────────────
# The Vercel CLI writes the project link and a copy of the production
# environment (including NOTION_TOKEN) in here.
.vercel/

# ── os / editor ─────────────────────────────────────────────────────────
.DS_Store
*.swp
*.pem

# ── local agent + session artefacts ─────────────────────────────────────
.claude/settings.local.json
.playwright-mcp/

# ── packaged static export for manual upload ────────────────────────────
infinite-site-godaddy.zip
